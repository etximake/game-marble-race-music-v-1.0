{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Music Ball Job Music Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["video", "audio", "text"],
  "properties": {
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "output_name"],
      "properties": {
        "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "output_name": {"type": "string", "minLength": 1}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_mode", "note_clips_dir", "audio_delay_ms", "loop_notes", "notes"],
      "properties": {
        "note_mode": {"type": "string", "enum": ["next_note_on_trigger"]},
        "note_clips_dir": {"type": "string", "minLength": 1},
        "audio_delay_ms": {"type": "integer", "minimum": 0},
        "loop_notes": {"type": "boolean"},
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "file"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "file": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_text", "top_text", "bottom_text"],
      "properties": {
        "show_text": {"type": "boolean"},
        "top_text": {"type": "string"},
        "bottom_text": {"type": "string"},
        "song_name": {"type": "string"}
      }
    },
    "job_assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ball_icon_path": {"type": "string"},
        "ball_color": {
          "type": "string",
          "anyOf": [
            {"const": ""},
            {"pattern": "^#[0-9A-Fa-f]{6}$"}
          ]
        }
      }
    }
  }
}
